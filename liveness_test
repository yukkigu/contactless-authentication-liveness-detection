# --- Validation fake images ---
for image in val_list0:
    target = df_impost.loc[df_impost['path'] == image, 'label'].values[0]
    label = 'client_image' if target == 1 else 'imposed_image'

    folder_path = os.path.join(base, image)
    files = os.listdir(folder_path)
    for file_name in files:
        src_file = os.path.join(folder_path, file_name)
        dst_file = os.path.join(val_dir, label, file_name)
        os.makedirs(os.path.dirname(dst_file), exist_ok=True)
        shutil.copyfile(src_file, dst_file)


train_datagen = ImageDataGenerator(
    rescale=1./255,
    rotation_range=10,
    width_shift_range=0.1,
    height_shift_range=0.1,
    horizontal_flip=True,
    zoom_range=0.1
)

val_datagen = ImageDataGenerator(rescale=1./255)

train_gen = train_datagen.flow_from_directory(
    train_dir,
    target_size=(203, 203),
    batch_size=32,
    class_mode='binary',
    shuffle=True,
    classes=['imposed_image', 'client_image']  # 0=spoof, 1=real
)

val_gen = val_datagen.flow_from_directory(
    val_dir,
    target_size=(203, 203),
    batch_size=32,
    class_mode='binary',
    shuffle=False,                           # DO NOT shuffle validation
    classes=['imposed_image', 'client_image'] # MUST match identical order
)

train_labels = train_gen.classes

class_weights = compute_class_weight(
    class_weight='balanced',
    classes=np.unique(train_labels),
    y=train_labels
)

class_weights_dict = {
    int(c): w for c, w in zip(np.unique(train_labels), class_weights)
}

print("Class weights:", class_weights_dict)

base_model = MobileNetV2(
    weights='imagenet',       # if no internet, change to None
    include_top=False,
    input_shape=(203, 203, 3)
)

# freeze backbone at first
base_model.trainable = False

x = base_model.output
x = GlobalAveragePooling2D()(x)
x = Dropout(0.5)(x)
output = Dense(1, activation='sigmoid')(x)   # binary output: spoof vs real

model = Model(inputs=base_model.input, outputs=output)

model.compile(
    optimizer='adam',
    loss='binary_crossentropy',
    metrics=['accuracy']
)

model.summary()


early = EarlyStopping(
    monitor='val_loss',
    patience=3,
    restore_best_weights=True
)

reduce_lr = ReduceLROnPlateau(
    monitor='val_loss',
    factor=0.5,
    patience=2,
    verbose=1
)

checkpoint = ModelCheckpoint(
    'best_cnn_liveness.h5',
    monitor='val_loss',
    save_best_only=True,
    verbose=1
)

history = model.fit(
    train_gen,
    epochs=5,                         # let EarlyStopping stop earlier if needed
    validation_data=val_gen,
    class_weight=class_weights_dict,
    callbacks=[early, reduce_lr, checkpoint]
)



val_loss, val_acc = model.evaluate(val_gen)
print("Keras evaluate() val_acc:", val_acc)

# classification_report + confusion_matrix
val_gen.reset()
steps = math.ceil(val_gen.samples / val_gen.batch_size)

preds = model.predict(val_gen, steps=steps, verbose=1)
y_pred = (preds > 0.5).astype(int).ravel()

y_true = val_gen.classes[:len(y_pred)]

print("Shapes:", y_true.shape, y_pred.shape)
print(classification_report(y_true, y_pred))
print(confusion_matrix(y_true, y_pred))



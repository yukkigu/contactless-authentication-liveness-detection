import os
import cv2
import glob
import numpy as np

DATASET_DIR = base  # "/content/drive/MyDrive/raw"

X = []
y = []

# Folder names must match EXACTLY (case-sensitive)
label_map = {"ClientRaw": 1, "ImposterRaw": 0}

IMAGE_SIZE = 32  # resize to 32x32

for folder_name, label in label_map.items():
    folder = os.path.join(DATASET_DIR, folder_name)
    print(f"Looking in: {folder}")
    print("  Exists?", os.path.exists(folder))

    # Recursively find all files under this folder
    pattern = os.path.join(folder, "**", "*.*")
    image_paths = glob.glob(pattern, recursive=True)

    print(f"  Found {len(image_paths)} files (before filtering)")

    for img_path in image_paths:
        # keep only typical image extensions
        if not img_path.lower().endswith((".jpg", ".jpeg", ".png", ".bmp")):
            continue

        img = cv2.imread(img_path)
        if img is None:
            continue

        img = cv2.resize(img, (IMAGE_SIZE, IMAGE_SIZE))
        X.append(img.flatten())
        y.append(label)

X = np.array(X, dtype="float32") / 255.0  # normalize
y = np.array(y)

print("Data loaded:", X.shape, y.shape)


from sklearn.model_selection import train_test_split

X_train, X_test, y_train, y_test = train_test_split(
